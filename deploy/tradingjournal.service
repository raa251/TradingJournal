[Unit]
Description=Trading Journal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/tradingjournal
Environment=HOST=0.0.0.0
Environment=PORT=3000
# Database + default image folder; point this at an external drive if needed:
Environment=TJ_DATA_DIR=/home/pi/tradingjournal-data
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server/index.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
